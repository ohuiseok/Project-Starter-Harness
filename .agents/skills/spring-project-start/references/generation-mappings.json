{
  "schemaVersion": 1,
  "initializrService": "https://start.spring.io",
  "contributorStrategies": {
    "single-module-layout": "initializr-covered",
    "single-datasource": "initializr-covered",
    "jpa-persistence": "initializr-covered",
    "mybatis-persistence": "initializr-covered",
    "jdbc-persistence": "initializr-covered",
    "flyway-migrations": "initializr-covered",
    "liquibase-migrations": "initializr-covered",
    "session-security": "initializr-covered",
    "token-security": "manual-conflict",
    "oidc-security": "manual-conflict",
    "mixed-channel-security": "manual-conflict",
    "mixed-channel-structure": "manual-conflict",
    "thymeleaf-view": "initializr-covered",
    "jsp-view": "manual-conflict",
    "mixed-persistence": "manual-conflict",
    "multiple-datasources": "manual-conflict",
    "read-write-routing": "manual-conflict",
    "tenant-datasource-routing": "manual-conflict",
    "service-owned-databases": "manual-conflict",
    "layered-monolith-layout": "manual-conflict",
    "modular-monolith-layout": "manual-conflict",
    "microservice-workspace": "manual-conflict",
    "hybrid-workspace": "manual-conflict",
    "grpc-integration": "manual-conflict",
    "messaging-integration": "manual-conflict",
    "file-or-polling-integration": "manual-conflict",
    "container-image": "manual-conflict",
    "native-image": "initializr-covered",
    "server-deployment": "manual-conflict",
    "container-deployment": "manual-conflict",
    "kubernetes-deployment": "manual-conflict"
  },
  "optionMappings": {
    "language.java": {"initializr": {"language": "java"}},
    "language.kotlin": {"initializr": {"language": "kotlin"}},
    "build.gradle-kotlin": {"initializr": {"type": "gradle-project-kotlin"}},
    "build.gradle-groovy": {"initializr": {"type": "gradle-project"}},
    "build.maven": {"initializr": {"type": "maven-project"}},

    "application.rest-api": {"initializr": {"dependencies": ["web"]}, "capabilities": ["http-api"]},
    "application.server-web": {"initializr": {"dependencies": ["web"]}, "capabilities": ["server-web"]},
    "application.batch": {"initializr": {"dependencies": ["batch"]}, "capabilities": ["batch"]},
    "application.mixed": {"contributors": ["mixed-channel-structure"], "reviews": ["Define each channel and its entry point before execution."]},

    "view.none": {},
    "view.thymeleaf": {"initializr": {"dependencies": ["thymeleaf"]}, "contributors": ["thymeleaf-view"]},
    "view.jsp": {"contributors": ["jsp-view"], "reviews": ["Verify JSP support for the resolved Spring Boot and servlet-container versions."]},
    "view.separate-client": {"externalPrerequisites": ["A separately owned client project or delivery plan"]},

    "security.none": {},
    "security.session": {"initializr": {"dependencies": ["security"]}, "contributors": ["session-security"]},
    "security.token": {"initializr": {"dependencies": ["security", "oauth2-resource-server"]}, "contributors": ["token-security"]},
    "security.oidc": {"initializr": {"dependencies": ["security", "oauth2-client"]}, "contributors": ["oidc-security"]},
    "security.mixed": {"initializr": {"dependencies": ["security", "oauth2-client", "oauth2-resource-server"]}, "contributors": ["mixed-channel-security"], "reviews": ["Define authentication and authorization boundaries for each channel."]},

    "authorization.none": {},
    "authorization.authenticated": {"capabilities": ["authenticated-access"]},
    "authorization.roles": {"capabilities": ["role-or-permission-authorization"]},

    "database.none": {},
    "database.h2": {"initializr": {"dependencies": ["h2"]}},
    "database.postgresql": {"initializr": {"dependencies": ["postgresql"]}, "externalPrerequisites": ["PostgreSQL connection supplied outside source control"], "requiredSecrets": ["DB_URL", "DB_USERNAME", "DB_PASSWORD"]},
    "database.mysql": {"initializr": {"dependencies": ["mysql"]}, "externalPrerequisites": ["MySQL or MariaDB connection supplied outside source control"], "requiredSecrets": ["DB_URL", "DB_USERNAME", "DB_PASSWORD"]},
    "database.oracle": {"initializr": {"dependencies": ["oracle"]}, "externalPrerequisites": ["Oracle connection and driver compatibility verification"], "requiredSecrets": ["DB_URL", "DB_USERNAME", "DB_PASSWORD"]},
    "database.non-relational": {"reviews": ["Resolve the exact non-relational technology before execution."]},

    "persistence.none": {},
    "persistence.jpa": {"initializr": {"dependencies": ["data-jpa"]}, "contributors": ["jpa-persistence"]},
    "persistence.mybatis": {"initializr": {"dependencies": ["mybatis"]}, "contributors": ["mybatis-persistence"]},
    "persistence.jdbc": {"initializr": {"dependencies": ["jdbc"]}, "contributors": ["jdbc-persistence"]},
    "persistence.mixed": {"contributors": ["mixed-persistence"], "reviews": ["Map each persistence style to explicit modules and data stores."]},

    "database-topology.none": {},
    "database-topology.single": {"contributors": ["single-datasource"]},
    "database-topology.multiple": {"contributors": ["multiple-datasources"]},
    "database-topology.read-write": {"contributors": ["read-write-routing"]},
    "database-topology.tenant": {"contributors": ["tenant-datasource-routing"]},
    "database-topology.per-service": {"contributors": ["service-owned-databases"]},

    "migration.none": {},
    "migration.flyway": {"initializr": {"dependencies": ["flyway"]}, "contributors": ["flyway-migrations"]},
    "migration.liquibase": {"initializr": {"dependencies": ["liquibase"]}, "contributors": ["liquibase-migrations"]},
    "migration.external": {"externalPrerequisites": ["Documented external schema migration owner and process"]},

    "architecture.single-module": {"projectShape": "single-project", "contributors": ["single-module-layout"]},
    "architecture.layered-monolith": {"projectShape": "single-project", "contributors": ["layered-monolith-layout"]},
    "architecture.modular-monolith": {"projectShape": "single-project", "contributors": ["modular-monolith-layout"]},
    "architecture.microservices": {"projectShape": "multi-project", "contributors": ["microservice-workspace"], "reviews": ["Compile and validate one child generation plan for every service before dry run."]},
    "architecture.hybrid": {"projectShape": "multi-project", "contributors": ["hybrid-workspace"], "reviews": ["Define every deployable and compile its child generation plan before dry run."]},

    "integration.none": {},
    "integration.http": {"capabilities": ["http-integration"]},
    "integration.grpc": {"contributors": ["grpc-integration"], "reviews": ["Select client, server, or both gRPC roles before execution."]},
    "integration.messaging": {"contributors": ["messaging-integration"], "reviews": ["Select the broker and delivery guarantees before execution."]},
    "integration.file-polling": {"contributors": ["file-or-polling-integration"]},

    "packaging.jar": {"initializr": {"packaging": "jar"}},
    "packaging.war": {"initializr": {"packaging": "war"}},
    "packaging.container": {"initializr": {"packaging": "jar"}, "contributors": ["container-image"]},
    "packaging.native": {"initializr": {"packaging": "jar", "dependencies": ["native"]}, "contributors": ["native-image"]},

    "deployment.local": {},
    "deployment.server": {"contributors": ["server-deployment"]},
    "deployment.container": {"contributors": ["container-deployment"]},
    "deployment.kubernetes": {"contributors": ["kubernetes-deployment"], "externalPrerequisites": ["Kubernetes cluster, namespace, and secret delivery policy"]},

    "verification.unit-only": {"verification": ["unit-tests"]},
    "verification.spring-integration": {"verification": ["unit-tests", "spring-integration-tests"]},
    "verification.testcontainers": {"initializr": {"dependencies": ["testcontainers"]}, "verification": ["unit-tests", "dependency-integration-tests"]},
    "verification.contract-e2e": {"verification": ["unit-tests", "contract-tests", "end-to-end-tests"]}
  }
}
