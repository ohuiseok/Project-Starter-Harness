#!/usr/bin/env bash
# Test suite for the Harness scripts.
#
# Usage: tests/run-tests
set -u

TESTS_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
HARNESS_ROOT="$(CDPATH= cd -- "$TESTS_DIR/.." && pwd -P)"
SCRIPTS="$HARNESS_ROOT/scripts"

PASSED=0
FAILED=0

fail() {
  printf 'FAIL: %s\n' "$1"
  [ "$#" -gt 1 ] && printf '  %s\n' "$2"
  FAILED=$((FAILED + 1))
}

pass() {
  printf 'ok: %s\n' "$1"
  PASSED=$((PASSED + 1))
}

# run_script NAME ARGS...  -> sets OUT and CODE, never hangs.
run_script() {
  local name="$1"
  shift
  OUT="$(timeout 20 "$SCRIPTS/$name" "$@" 2>&1)"
  CODE=$?
}

expect_code() {
  local label="$1" want="$2"
  if [ "$CODE" -eq 124 ]; then
    fail "$label" "script timed out (infinite loop?)"
  elif [ "$CODE" -ne "$want" ]; then
    fail "$label" "expected exit $want, got $CODE"
  else
    pass "$label"
  fi
}

expect_out() {
  local label="$1" needle="$2"
  if printf '%s' "$OUT" | grep -qF -- "$needle"; then
    pass "$label"
  else
    fail "$label" "missing output: $needle"
  fi
}

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

