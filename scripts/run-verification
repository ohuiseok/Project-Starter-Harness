#!/usr/bin/env bash
set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
. "$SCRIPT_DIR/lib/common.sh"

parse_target_args "$@"
require_target_dir

printf 'TARGET_PATH: %s\n' "$TARGET_ABS"

# A freshly cloned repo can carry a wrapper without the executable bit,
# so fall back to running it through sh rather than reporting UNKNOWN.
if [ -f "$TARGET_ABS/gradlew" ]; then
  if [ -x "$TARGET_ABS/gradlew" ]; then
    RUNNER="./gradlew"
  else
    RUNNER="sh ./gradlew"
  fi
  COMMAND="$RUNNER test"
elif [ -f "$TARGET_ABS/mvnw" ]; then
  if [ -x "$TARGET_ABS/mvnw" ]; then
    RUNNER="./mvnw"
  else
    RUNNER="sh ./mvnw"
  fi
  COMMAND="$RUNNER test"
else
  printf 'VERIFICATION_COMMAND: UNKNOWN\n'
  printf 'VERIFICATION_RESULT: UNKNOWN\n'
  printf 'UNKNOWN: no Gradle or Maven wrapper found\n'
  exit "$EXIT_UNKNOWN"
fi

printf 'VERIFICATION_COMMAND: %s\n' "$COMMAND"

(cd "$TARGET_ABS" && $COMMAND)
STATUS=$?

printf 'VERIFICATION_EXIT_CODE: %s\n' "$STATUS"

if [ "$STATUS" -eq 0 ]; then
  printf 'VERIFICATION_RESULT: passed\n'
  exit 0
fi

printf 'VERIFICATION_RESULT: failed\n'
exit 1
