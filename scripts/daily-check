#!/usr/bin/env bash
set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
. "$SCRIPT_DIR/lib/common.sh"

usage() {
  printf 'Usage: %s --target PATH [--base REF] [--head REF] --baseline BRANCH\n' "$0" >&2
}

TARGET="${TARGET_REPOSITORY:-}"
BASE="ORIG_HEAD"
HEAD_REF="HEAD"
BASELINE=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --target)
      need_value "$1" "$#"
      TARGET="$2"
      shift 2
      ;;
    --base)
      need_value "$1" "$#"
      BASE="$2"
      shift 2
      ;;
    --head)
      need_value "$1" "$#"
      HEAD_REF="$2"
      shift 2
      ;;
    --baseline)
      need_value "$1" "$#"
      BASELINE="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'UNKNOWN: unsupported argument: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

resolve_target_from_config
require_commands git rg
require_target_git_root

if [ -z "$BASELINE" ]; then
  BASELINE="$(read_config_value branch || true)"
fi

if [ -z "$BASELINE" ]; then
  printf 'UNKNOWN: baseline branch is required. Set baseline.branch in config/target.local.yaml or pass --baseline.\n' >&2
  exit 2
fi

CURRENT_BRANCH="$(git -C "$TARGET_ROOT" branch --show-current 2>/dev/null || true)"
if [ -z "$CURRENT_BRANCH" ]; then
  CURRENT_BRANCH="DETACHED_HEAD"
fi

BASELINE_BRANCH="$BASELINE"
RECOMMENDATION_CONFIDENCE="RULE_BASED"
if ! git -C "$TARGET_ROOT" rev-parse --verify "$BASELINE" >/dev/null 2>&1; then
  printf 'UNKNOWN: baseline branch/ref cannot be verified in target repository: %s\n' "$BASELINE" >&2
  exit 2
fi

BASE_AVAILABLE=1
HEAD_AVAILABLE=1
git -C "$TARGET_ROOT" rev-parse --verify "$BASE" >/dev/null 2>&1 || BASE_AVAILABLE=0
git -C "$TARGET_ROOT" rev-parse --verify "$HEAD_REF" >/dev/null 2>&1 || HEAD_AVAILABLE=0

TIMESTAMP="$(date '+%Y%m%d-%H%M%S')-$$"
CREATED_AT="$(date '+%Y-%m-%dT%H:%M:%S%z')"
AUTO_ROOT="$HARNESS_ROOT/reports/auto-check"
UNREVIEWED_DIR="$AUTO_ROOT/unreviewed"
REPORT_FILE="$UNREVIEWED_DIR/$TIMESTAMP.md"
LATEST_FILE="$AUTO_ROOT/latest.md"
mkdir -p "$UNREVIEWED_DIR"

TMP_CHANGED="$(mktemp)"
TMP_ROWS="$(mktemp)"
TMP_RISKS="$(mktemp)"
TMP_STALE="$(mktemp)"
trap 'rm -f "$TMP_CHANGED" "$TMP_ROWS" "$TMP_RISKS" "$TMP_STALE"' EXIT

if [ "$BASE_AVAILABLE" -eq 1 ] && [ "$HEAD_AVAILABLE" -eq 1 ]; then
  git -C "$TARGET_ROOT" diff --name-status "$BASE" "$HEAD_REF" -- . ':!**/*.class' ':!**/build/**' ':!**/target/**' ':!**/dist/**' > "$TMP_CHANGED"
fi

priority_value() {
  case "$1" in
    PROPOSE_KNOWLEDGE) printf '4' ;;
    NEEDS_REVIEW) printf '3' ;;
    REPORT_ONLY) printf '2' ;;
    DISCARD) printf '1' ;;
    *) printf '0' ;;
  esac
}

classify_file() {
  file="$1"
  lower="$(printf '%s' "$file" | tr '[:upper:]' '[:lower:]')"
  area="General"
  risk="LOW"
  recommendation="NEEDS_REVIEW"

  case "$lower" in
    *'/build/'*|build/*|*'/target/'*|target/*|*'/dist/'*|dist/*|*.class|*.tmp)
      area="Generated/Build Output"; risk="LOW"; recommendation="DISCARD" ;;
    *'/src/test/'*|*'/test/'*)
      area="Test"; risk="MEDIUM"; recommendation="REPORT_ONLY" ;;
    docs/*|*.md|readme*|*/readme*)
      area="Docs"; risk="LOW"; recommendation="REPORT_ONLY" ;;
    *security*|*auth*|*jwt*|*permission*|*role*)
      area="Security/Auth"; risk="HIGH"; recommendation="PROPOSE_KNOWLEDGE" ;;
    *customer*|*tenant*|*feature*|*config*|*.yml|*.yaml|*.properties)
      area="Customer/Config"; risk="HIGH"; recommendation="PROPOSE_KNOWLEDGE" ;;
    *service*|*domain*|*entity*|*policy*|*validator*)
      area="Service/Domain Rule"; risk="HIGH"; recommendation="PROPOSE_KNOWLEDGE" ;;
    *controller*|*api*)
      area="Controller/API"; risk="MEDIUM"; recommendation="NEEDS_REVIEW" ;;
    *repository*|*mapper*|*.xml|*.sql|*persistence*)
      area="Persistence"; risk="HIGH"; recommendation="NEEDS_REVIEW" ;;
  esac

  printf '%s|%s|%s\n' "$area" "$risk" "$recommendation"
}

OVERALL_RECOMMENDATION="DISCARD"
PRODUCTION_CHANGED=0
TEST_CHANGED=0
DOCS_ONLY=1
CHANGE_COUNT=0

if [ "$BASE_AVAILABLE" -eq 1 ] && [ "$HEAD_AVAILABLE" -eq 1 ]; then
  while IFS="$(printf '\t')" read -r status file rest; do
    [ -n "${status:-}" ] || continue
    [ -n "${file:-}" ] || continue
    # Rename output has old path in file and new path in rest; report the new path.
    if [ -n "${rest:-}" ]; then
      file="$rest"
    fi
    CHANGE_COUNT=$((CHANGE_COUNT + 1))
    classification="$(classify_file "$file")"
    area="$(printf '%s' "$classification" | cut -d '|' -f 1)"
    risk="$(printf '%s' "$classification" | cut -d '|' -f 2)"
    recommendation="$(printf '%s' "$classification" | cut -d '|' -f 3)"
    printf '| %s | `%s` | %s | %s | %s |\n' "$status" "$file" "$area" "$risk" "$recommendation" >> "$TMP_ROWS"

    case "$file" in
      *src/main*|*.java|*.xml|*.sql|*.yml|*.yaml|*.properties) PRODUCTION_CHANGED=1 ;;
    esac
    case "$file" in
      *src/test*|*test*) TEST_CHANGED=1 ;;
    esac
    case "$recommendation" in
      DISCARD|REPORT_ONLY) ;;
      *) DOCS_ONLY=0 ;;
    esac

    if [ "$(priority_value "$recommendation")" -gt "$(priority_value "$OVERALL_RECOMMENDATION")" ]; then
      OVERALL_RECOMMENDATION="$recommendation"
    fi

    if rg -n --fixed-strings "$file" "$HARNESS_ROOT/knowledge" >/dev/null 2>&1; then
      rg -l --fixed-strings "$file" "$HARNESS_ROOT/knowledge" 2>/dev/null | while IFS= read -r knowledge_file; do
        printf '| `%s` | 변경된 target file `%s`를 참조합니다. | PROPOSE_KNOWLEDGE |\n' "${knowledge_file#$HARNESS_ROOT/}" "$file" >> "$TMP_STALE"
      done
      OVERALL_RECOMMENDATION="PROPOSE_KNOWLEDGE"
    fi
  done < "$TMP_CHANGED"
fi

if [ "$PRODUCTION_CHANGED" -eq 1 ] && [ "$TEST_CHANGED" -eq 1 ] && [ "$(priority_value "$OVERALL_RECOMMENDATION")" -lt 3 ]; then
  OVERALL_RECOMMENDATION="NEEDS_REVIEW"
fi

if [ "$CHANGE_COUNT" -eq 0 ] && [ "$BASE_AVAILABLE" -eq 1 ] && [ "$HEAD_AVAILABLE" -eq 1 ]; then
  OVERALL_RECOMMENDATION="REPORT_ONLY"
fi

{
  if [ "$BASE_AVAILABLE" -eq 0 ]; then
    printf -- '- 기준 ref `%s`를 확인할 수 없어 변경 파일 수집이 제한됩니다.\n' "$BASE"
  fi
  if [ "$HEAD_AVAILABLE" -eq 0 ]; then
    printf -- '- 대상 ref `%s`를 확인할 수 없어 변경 파일 수집이 제한됩니다.\n' "$HEAD_REF"
  fi
  if [ "$BASELINE_BRANCH" != "UNKNOWN" ] && [ "$CURRENT_BRANCH" != "$BASELINE_BRANCH" ]; then
    printf -- '- baseline branch와 current branch가 다릅니다. Baseline behavior와 current branch behavior를 분리해야 합니다.\n'
  fi
  if [ "$PRODUCTION_CHANGED" -eq 1 ]; then
    printf -- '- production code/config/persistence 후보가 변경되었습니다.\n'
  fi
  if [ "$TEST_CHANGED" -eq 1 ]; then
    printf -- '- test 변경이 포함되어 있습니다.\n'
  fi
  if [ "$DOCS_ONLY" -eq 1 ] && [ "$CHANGE_COUNT" -gt 0 ]; then
    printf -- '- 변경이 docs/report 성격으로 보입니다. 그래도 Recommendation은 fact가 아닙니다.\n'
  fi
  if [ ! -s "$TMP_STALE" ]; then
    printf -- '- Approved Knowledge가 없거나 evidence path 형식이 표준화되지 않으면 stale 후보 탐지는 제한적입니다.\n'
  fi
} > "$TMP_RISKS"

{
  printf '# 자동 변경 점검 리포트\n\n'
  printf '이 리포트는 로컬 script가 생성한 임시 산출물입니다. Source of Truth가 아니며,\n'
  printf 'Recommendation은 rule-based candidate입니다. Knowledge 저장/수정 또는 Business Rule 확정은 사람 승인 없이는 하지 않습니다.\n\n'
  printf '```yaml\n'
  printf 'status: UNREVIEWED\n'
  printf 'created_at: %s\n' "$CREATED_AT"
  printf 'target_repository: %s\n' "$TARGET_ROOT"
  printf 'baseline_branch: %s\n' "$BASELINE_BRANCH"
  printf 'current_branch: %s\n' "$CURRENT_BRANCH"
  printf 'base_ref: %s\n' "$BASE"
  printf 'head_ref: %s\n' "$HEAD_REF"
  printf 'knowledge_recommendation: %s\n' "$OVERALL_RECOMMENDATION"
  printf 'recommendation_confidence: %s\n' "$RECOMMENDATION_CONFIDENCE"
  printf '```\n\n'
  printf '## 요약\n\n'
  if [ "$CHANGE_COUNT" -gt 0 ]; then
    printf 'Target repository에서 %s개 변경 파일 후보를 감지했습니다.\n\n' "$CHANGE_COUNT"
  elif [ "$BASE_AVAILABLE" -eq 1 ] && [ "$HEAD_AVAILABLE" -eq 1 ]; then
    printf 'Target repository에서 지정된 ref 사이의 변경 파일이 없습니다.\n\n'
  else
    printf 'Target repository 변경 확인이 부분적으로 실패했습니다. UNKNOWN으로 처리해야 합니다.\n\n'
  fi
  printf '## 변경된 파일\n\n'
  printf '| 상태 | 파일 | 영역 | 위험 | Knowledge 추천 |\n'
  printf '|---|---|---|---|---|\n'
  if [ -s "$TMP_ROWS" ]; then
    cat "$TMP_ROWS"
  else
    printf '| UNKNOWN | UNKNOWN | UNKNOWN | UNKNOWN | %s |\n' "$OVERALL_RECOMMENDATION"
  fi
  printf '\n## 위험 후보\n\n'
  cat "$TMP_RISKS"
  printf '\n## 오래된 Knowledge 후보\n\n'
  printf '| Knowledge | 이유 | 추천 |\n'
  printf '|---|---|---|\n'
  if [ -s "$TMP_STALE" ]; then
    sort -u "$TMP_STALE"
  else
    printf '| UNKNOWN | Approved Knowledge가 없거나 evidence path 형식이 표준화되지 않았을 수 있습니다. | NEEDS_REVIEW |\n'
  fi
  printf '\n## 현재 작업 영향\n\nUNKNOWN\n\n'
  printf '## 추천 프롬프트\n\n'
  printf '```text\n'
  printf 'spring-verify-knowledge를 사용해서 reports/auto-check/latest.md를 검토해줘.\n'
  printf '방금 pull한 변경사항이 기존 Knowledge, 고객사 로직, 현재 작업 브랜치에 미치는 영향을 분석해줘.\n'
  printf 'Knowledge는 자동 수정하지 말고 proposal만 작성해줘.\n'
  printf '확인하지 못한 내용은 UNKNOWN으로 표시해줘.\n'
  printf '```\n\n'
  printf '## 사용자 확인 상태\n\n'
  printf '```yaml\n'
  printf 'reviewed: false\n'
  printf 'reviewed_at: UNKNOWN\n'
  printf 'reviewed_by: UNKNOWN\n'
  printf 'review_decision: UNKNOWN\n'
  printf 'knowledge_update: UNKNOWN\n'
  printf '```\n'
} > "$REPORT_FILE"

{
  printf '# Latest Auto Check\n\n'
  printf '```yaml\n'
  printf 'status: UNREVIEWED\n'
  printf 'latest_report: %s\n' "${REPORT_FILE#$HARNESS_ROOT/}"
  printf 'created_at: %s\n' "$CREATED_AT"
  printf 'target_repository: %s\n' "$TARGET_ROOT"
  printf 'baseline_branch: %s\n' "$BASELINE_BRANCH"
  printf 'current_branch: %s\n' "$CURRENT_BRANCH"
  printf 'knowledge_recommendation: %s\n' "$OVERALL_RECOMMENDATION"
  printf 'recommendation_confidence: %s\n' "$RECOMMENDATION_CONFIDENCE"
  printf '```\n\n'
  printf '자세한 내용은 `%s`를 확인하세요.\n' "${REPORT_FILE#$HARNESS_ROOT/}"
} > "$LATEST_FILE"

printf '[Project Starter Harness] daily-check complete\n'
printf 'Report: %s\n' "${REPORT_FILE#$HARNESS_ROOT/}"
printf 'Latest: %s\n' "${LATEST_FILE#$HARNESS_ROOT/}"
printf 'Changed files: %s\n' "$CHANGE_COUNT"
printf 'Knowledge recommendation: %s\n' "$OVERALL_RECOMMENDATION"
printf 'Recommendation confidence: %s\n' "$RECOMMENDATION_CONFIDENCE"

if [ "$BASE_AVAILABLE" -eq 0 ] || [ "$HEAD_AVAILABLE" -eq 0 ] || [ "$CHANGE_COUNT" -eq 0 ] || [ ! -s "$TMP_STALE" ]; then
  exit 1
fi
exit 0
