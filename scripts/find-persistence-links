#!/usr/bin/env bash
set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
. "$SCRIPT_DIR/lib/common.sh"

usage() {
  printf 'Usage: %s --target PATH [--query TEXT]\n' "$0" >&2
}

TARGET="${TARGET_REPOSITORY:-}"
QUERY=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --target)
      need_value "$1" "$#"
      TARGET="$2"
      shift 2
      ;;
    --query)
      need_value "$1" "$#"
      QUERY="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'UNKNOWN: unsupported argument: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

resolve_target_from_config
require_commands git rg
require_target_git_root

printf '# Persistence Link Candidates\n\n'
printf 'Target: %s\n' "$TARGET_ROOT"
printf 'Query: %s\n\n' "${QUERY:-UNKNOWN}"

printf '## Persistence Technology Candidates\n'
MYBATIS_COUNT="$(rg -n --glob '*.java' --glob '*.xml' '(@Mapper|<mapper[[:space:]]|<(select|insert|update|delete)[[:space:]])' "$TARGET_ROOT" 2>/dev/null | wc -l | tr -d ' ')"
JPA_COUNT="$(rg -n --glob '*.java' '(JpaRepository|CrudRepository|PagingAndSortingRepository|Repository<|@Entity|@Table|EntityManager|@Query|Specification<|Querydsl|JPAQuery)' "$TARGET_ROOT" 2>/dev/null | wc -l | tr -d ' ')"
JDBC_COUNT="$(rg -n --glob '*.java' '(JdbcTemplate|NamedParameterJdbcTemplate|java.sql.|DataSource)' "$TARGET_ROOT" 2>/dev/null | wc -l | tr -d ' ')"
if [ "$MYBATIS_COUNT" -gt 0 ] && [ "$JPA_COUNT" -gt 0 ]; then
  printf -- '- Mixed: MyBatis and JPA / Spring Data JPA candidates found\n'
elif [ "$MYBATIS_COUNT" -gt 0 ]; then
  printf -- '- MyBatis candidates found\n'
elif [ "$JPA_COUNT" -gt 0 ]; then
  printf -- '- JPA / Spring Data JPA candidates found\n'
elif [ "$JDBC_COUNT" -gt 0 ]; then
  printf -- '- JDBC candidates found\n'
else
  printf -- '- UNKNOWN\n'
fi
printf 'MyBatis candidate lines: %s\n' "$MYBATIS_COUNT"
printf 'JPA candidate lines: %s\n' "$JPA_COUNT"
printf 'JDBC candidate lines: %s\n' "$JDBC_COUNT"

printf '\n## MyBatis Mapper Interfaces\n'
rg -n --glob '*.java' '(@Mapper|interface .*Mapper|interface .*Dao)' "$TARGET_ROOT" 2>/dev/null | sed "s#^$TARGET_ROOT/##" | head -n 300

printf '\n## Mapper XML Namespaces\n'
rg -n --glob '*.xml' '<mapper[[:space:]][^>]*namespace=' "$TARGET_ROOT" 2>/dev/null | sed "s#^$TARGET_ROOT/##" | head -n 300

printf '\n## MyBatis SQL Statement IDs\n'
rg -n --glob '*.xml' '<(select|insert|update|delete)[[:space:]][^>]*id=' "$TARGET_ROOT" 2>/dev/null | sed "s#^$TARGET_ROOT/##" | head -n 300

printf '\n## MyBatis Dynamic SQL / Fragment Candidates\n'
rg -n --glob '*.xml' '<(if|choose|when|otherwise|foreach|where|trim|set|include|resultMap|sql)[[:space:]>]' "$TARGET_ROOT" 2>/dev/null | sed "s#^$TARGET_ROOT/##" | head -n 300

printf '\n## JPA / Spring Data Repository Candidates\n'
rg -n --glob '*.java' '(extends[^{;]*(JpaRepository|CrudRepository|PagingAndSortingRepository|Repository<)|@Repository)' "$TARGET_ROOT" 2>/dev/null | sed "s#^$TARGET_ROOT/##" | head -n 300

printf '\n## Spring Data Query Method Candidates\n'
rg -n --glob '*.java' '(find|read|get|query|count|exists|delete|remove)(Distinct)?By[A-Z][A-Za-z0-9_]*[[:space:]]*\(' "$TARGET_ROOT" 2>/dev/null | sed "s#^$TARGET_ROOT/##" | head -n 300

printf '\n## @Query / JPQL / Native Query Candidates\n'
rg -n --glob '*.java' '(@Query|nativeQuery[[:space:]]*=|createQuery|createNativeQuery)' "$TARGET_ROOT" 2>/dev/null | sed "s#^$TARGET_ROOT/##" | head -n 300

printf '\n## Entity Candidates\n'
rg -n --glob '*.java' '(@Entity|@Table|@Id|@Column|@JoinColumn)' "$TARGET_ROOT" 2>/dev/null | sed "s#^$TARGET_ROOT/##" | head -n 300

printf '\n## JPA Relationship Candidates\n'
rg -n --glob '*.java' '@(OneToMany|ManyToOne|OneToOne|ManyToMany)' "$TARGET_ROOT" 2>/dev/null | sed "s#^$TARGET_ROOT/##" | head -n 300

printf '\n## Transaction Candidates\n'
rg -n --glob '*.java' '@Transactional|TransactionTemplate|PlatformTransactionManager' "$TARGET_ROOT" 2>/dev/null | sed "s#^$TARGET_ROOT/##" | head -n 300

printf '\n## JDBC Candidates\n'
rg -n --glob '*.java' '(JdbcTemplate|NamedParameterJdbcTemplate|java.sql.|DataSource)' "$TARGET_ROOT" 2>/dev/null | sed "s#^$TARGET_ROOT/##" | head -n 300

if [ -n "$QUERY" ]; then
  printf '\n## Query Matches\n'
  rg -n -i --glob '*.java' --glob '*.xml' "$QUERY" "$TARGET_ROOT" 2>/dev/null | sed "s#^$TARGET_ROOT/##" | head -n 300
fi

printf '\n## P0 Limitations\n'
printf -- '- Dynamic SQL is reported as candidate evidence only.\n'
printf -- '- include, resultMap, nested select, stored procedure, view, and multiple datasource semantics are not fully resolved in P0.\n'
printf -- '- JPA lazy loading, flush timing, dirty checking, JPQL semantics, QueryDSL AST, and runtime datasource routing are not resolved in P0.\n'
printf -- '- Table names are candidate strings from SQL or @Table, not confirmed schema analysis.\n'

if [ "$MYBATIS_COUNT" -eq 0 ] && [ "$JPA_COUNT" -eq 0 ] && [ "$JDBC_COUNT" -eq 0 ]; then
  exit 1
fi
