#!/usr/bin/env bash
set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
. "$SCRIPT_DIR/lib/common.sh"

usage() {
  printf 'Usage: %s --target PATH [--query TEXT]\n' "$0" >&2
}

TARGET="${TARGET_REPOSITORY:-}"
QUERY=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --target)
      need_value "$1" "$#"
      TARGET="$2"
      shift 2
      ;;
    --query)
      need_value "$1" "$#"
      QUERY="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'UNKNOWN: unsupported argument: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

resolve_target_from_config
require_commands git rg
require_target_git_root

printf '# Entry Point Candidates\n\n'
printf 'Target: %s\n' "$TARGET_ROOT"
printf 'Query: %s\n\n' "${QUERY:-UNKNOWN}"

printf '## Spring Entry Annotations\n'
ENTRY_MATCHES="$(rg -n --glob '*.java' '@(RestController|Controller|RequestMapping|GetMapping|PostMapping|PutMapping|DeleteMapping|PatchMapping|Scheduled|EventListener|KafkaListener|JmsListener)' "$TARGET_ROOT" 2>/dev/null | sed "s#^$TARGET_ROOT/##" | head -n 300)"
if [ -n "$ENTRY_MATCHES" ]; then
  printf '%s\n' "$ENTRY_MATCHES"
else
  printf 'UNKNOWN\n'
fi

if [ -n "$QUERY" ]; then
  printf '\n## Query Matches\n'
  QUERY_MATCHES="$(rg -n -i --glob '*.java' --glob '*.xml' --glob '*.yml' --glob '*.yaml' --glob '*.properties' "$QUERY" "$TARGET_ROOT" 2>/dev/null | sed "s#^$TARGET_ROOT/##" | head -n 300)"
  if [ -n "$QUERY_MATCHES" ]; then
    printf '%s\n' "$QUERY_MATCHES"
  else
    printf 'UNKNOWN\n'
  fi
fi

if [ -z "$ENTRY_MATCHES" ] && [ -z "${QUERY_MATCHES:-}" ]; then
  exit 1
fi
