#!/usr/bin/env bash
set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
. "$SCRIPT_DIR/lib/common.sh"

usage() {
  printf 'Usage: %s --target PATH [--base REF] [--head REF]\n' "$0" >&2
}

TARGET="${TARGET_REPOSITORY:-}"
BASE="HEAD~1"
HEAD_REF="HEAD"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --target)
      need_value "$1" "$#"
      TARGET="$2"
      shift 2
      ;;
    --base)
      need_value "$1" "$#"
      BASE="$2"
      shift 2
      ;;
    --head)
      need_value "$1" "$#"
      HEAD_REF="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'UNKNOWN: unsupported argument: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

resolve_target_from_config
require_commands git
require_target_git_root

BRANCH="$(git -C "$TARGET_ROOT" branch --show-current 2>/dev/null || true)"
if [ -z "$BRANCH" ]; then
  BRANCH="DETACHED_HEAD"
fi

printf '# Change Detection\n\n'
printf 'Target: %s\n' "$TARGET_ROOT"
printf 'Branch: %s\n' "$BRANCH"
printf 'Base: %s\n' "$BASE"
printf 'Head: %s\n\n' "$HEAD_REF"

if ! git -C "$TARGET_ROOT" rev-parse --verify "$BASE" >/dev/null 2>&1; then
  printf 'UNKNOWN: base ref is not available: %s\n' "$BASE" >&2
  exit 1
fi

if ! git -C "$TARGET_ROOT" rev-parse --verify "$HEAD_REF" >/dev/null 2>&1; then
  printf 'UNKNOWN: head ref is not available: %s\n' "$HEAD_REF" >&2
  exit 1
fi

git -C "$TARGET_ROOT" status --short
printf '\n## Changed Files\n'
git -C "$TARGET_ROOT" diff --name-status "$BASE" "$HEAD_REF" -- . ':!**/*.class' ':!**/build/**' ':!**/target/**'
