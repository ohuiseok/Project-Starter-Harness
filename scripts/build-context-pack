#!/usr/bin/env bash
set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
. "$SCRIPT_DIR/lib/common.sh"

usage() {
  printf 'Usage: %s --target PATH [--task TEXT] [--customer SCOPE]\n' "$0" >&2
}

TARGET="${TARGET_REPOSITORY:-}"
TASK=""
CUSTOMER="UNKNOWN"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --target)
      need_value "$1" "$#"
      TARGET="$2"
      shift 2
      ;;
    --task)
      need_value "$1" "$#"
      TASK="$2"
      shift 2
      ;;
    --customer)
      need_value "$1" "$#"
      CUSTOMER="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'UNKNOWN: unsupported argument: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

resolve_target_from_config
require_commands git rg
require_target_git_root

printf '# Context Pack\n\n'
printf '## Task\n\n%s\n\n' "${TASK:-UNKNOWN}"
printf '## Customer Scope\n\n%s\n\n' "$CUSTOMER"
printf '## Relevant Modules\n\n'
MODULE_CANDIDATES="$(find "$TARGET_ROOT" -maxdepth 3 \( -name pom.xml -o -name 'build.gradle*' \) -type f | sed "s#^$TARGET_ROOT/##" | sort | head -n 100)"
if [ -n "$MODULE_CANDIDATES" ]; then
  printf '%s\n' "$MODULE_CANDIDATES" | sed 's/^/- /'
else
  printf -- '- UNKNOWN\n'
fi
printf '\n## Entry Points\n\n'
ENTRY_CANDIDATES="$(rg -n --glob '*.java' '@(RestController|Controller|RequestMapping|Scheduled|EventListener|KafkaListener|JmsListener)' "$TARGET_ROOT" 2>/dev/null | sed "s#^$TARGET_ROOT/##" | head -n 100)"
if [ -n "$ENTRY_CANDIDATES" ]; then
  printf '%s\n' "$ENTRY_CANDIDATES" | sed 's/^/- /'
else
  printf -- '- UNKNOWN\n'
fi
printf '\n## Evidence\n\n'
printf '### Target Instructions / Project Docs\n\n'
DOC_CANDIDATES="$(find "$TARGET_ROOT" -maxdepth 4 \( -name AGENTS.md -o -name 'README*' -o -name pom.xml -o -name 'build.gradle*' -o -name 'settings.gradle*' -o -name gradlew -o -name mvnw \) -type f | sed "s#^$TARGET_ROOT/##" | sort | head -n 200)"
if [ -n "$DOC_CANDIDATES" ]; then
  printf '%s\n' "$DOC_CANDIDATES" | sed 's/^/- /'
else
  printf -- '- UNKNOWN\n'
fi
printf '\n'
printf '### Code\n\n- UNKNOWN\n\n'
printf '### Test\n\n'
TEST_CANDIDATES="$(find "$TARGET_ROOT" -maxdepth 6 \( -path '*/src/test/*' -o -path '*/test/*' \) -type f | sed "s#^$TARGET_ROOT/##" | sort | head -n 50)"
if [ -n "$TEST_CANDIDATES" ]; then
  printf '%s\n' "$TEST_CANDIDATES" | sed 's/^/- /'
else
  printf -- '- UNKNOWN\n'
fi
printf '\n### Config\n\n'
CONFIG_CANDIDATES="$(find "$TARGET_ROOT" -maxdepth 6 \( -name '*.properties' -o -name '*.yml' -o -name '*.yaml' \) -type f | sed "s#^$TARGET_ROOT/##" | sort | head -n 100)"
if [ -n "$CONFIG_CANDIDATES" ]; then
  printf '%s\n' "$CONFIG_CANDIDATES" | sed 's/^/- /'
else
  printf -- '- UNKNOWN\n'
fi
printf '\n### Persistence\n\n'
PERSISTENCE_CANDIDATES="$(CDPATH= cd -- "$TARGET_ROOT" && rg -n --glob '*.java' --glob '*.xml' '(@Mapper|<mapper[[:space:]]|<(select|insert|update|delete)[[:space:]]|JpaRepository|CrudRepository|PagingAndSortingRepository|@Repository|@Entity|@Table|@Id|@Column|@JoinColumn|@OneToMany|@ManyToOne|@OneToOne|@ManyToMany|@Query|Specification<|Querydsl|JPAQuery|EntityManager|JdbcTemplate|NamedParameterJdbcTemplate|@Transactional)' 2>/dev/null | sed "s#^$TARGET_ROOT/##" | head -n 150)"
MYBATIS_COUNT="$(printf '%s\n' "$PERSISTENCE_CANDIDATES" | rg '(@Mapper|<mapper[[:space:]]|<(select|insert|update|delete)[[:space:]])' 2>/dev/null | wc -l | tr -d ' ')"
JPA_COUNT="$(printf '%s\n' "$PERSISTENCE_CANDIDATES" | rg '(JpaRepository|CrudRepository|PagingAndSortingRepository|@Repository|@Entity|@Table|@Id|@Column|@JoinColumn|@OneToMany|@ManyToOne|@OneToOne|@ManyToMany|@Query|Specification<|Querydsl|JPAQuery|EntityManager)' 2>/dev/null | wc -l | tr -d ' ')"
JDBC_COUNT="$(printf '%s\n' "$PERSISTENCE_CANDIDATES" | rg '(JdbcTemplate|NamedParameterJdbcTemplate)' 2>/dev/null | wc -l | tr -d ' ')"
TECHNOLOGY="UNKNOWN"
if [ "$MYBATIS_COUNT" -gt 0 ] && [ "$JPA_COUNT" -gt 0 ]; then
  TECHNOLOGY="Mixed"
elif [ "$MYBATIS_COUNT" -gt 0 ]; then
  TECHNOLOGY="MyBatis"
elif [ "$JPA_COUNT" -gt 0 ]; then
  TECHNOLOGY="JPA / Spring Data JPA"
elif [ "$JDBC_COUNT" -gt 0 ]; then
  TECHNOLOGY="JDBC"
fi
printf 'Technology: %s\n' "$TECHNOLOGY"
printf 'Repository: UNKNOWN\n'
printf 'Mapper: UNKNOWN\n'
printf 'Entity: UNKNOWN\n'
printf 'Query: UNKNOWN\n'
printf 'Table: UNKNOWN\n'
printf 'Relationship: UNKNOWN\n'
printf 'Transaction: UNKNOWN\n'
printf 'Evidence:\n'
if [ -n "$PERSISTENCE_CANDIDATES" ]; then
  printf '%s\n' "$PERSISTENCE_CANDIDATES" | sed 's/^/- /'
else
  printf -- '- UNKNOWN\n'
fi
printf '\n### Git\n\n'
git -C "$TARGET_ROOT" log --oneline -n 10 | sed 's/^/- /'
printf '\n## Observed Behavior\n\nUNKNOWN\n\n'
printf '## Intended Behavior\n\nUNKNOWN\n\n'
printf '## Business Rule Candidates\n\n- UNKNOWN\n\n'
printf '## Customer Rule Candidates\n\n- UNKNOWN\n\n'
printf '## Impact\n\n### Common\n\nUNKNOWN\n\n### Customer\n\nUNKNOWN\n\n### API\n\nUNKNOWN\n\n### DB\n\nUNKNOWN\n\n### External\n\nUNKNOWN\n\n'
printf '## Tests\n\n- UNKNOWN\n\n'
printf '## Unknowns\n\n- Evidence requires human review before CONFIRMED status.\n\n'
printf '## Decision Needed\n\n- UNKNOWN\n'
