#!/usr/bin/env bash
set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
. "$SCRIPT_DIR/lib/common.sh"

parse_target_args "$@"
require_target_dir

printf 'TARGET_PATH: %s\n' "$TARGET_ABS"

if BUILD_FILE="$(detect_build_file "$TARGET_ABS")"; then
  printf 'BUILD_FILE: %s\n' "$BUILD_FILE"
else
  printf 'BUILD_FILE: UNKNOWN\n'
fi

if [ -d "$TARGET_ABS/src/main/java" ]; then
  printf 'SRC_MAIN_JAVA: yes\n'
else
  printf 'SRC_MAIN_JAVA: no\n'
fi

if [ -d "$TARGET_ABS/src/main/kotlin" ]; then
  printf 'SRC_MAIN_KOTLIN: yes\n'
else
  printf 'SRC_MAIN_KOTLIN: no\n'
fi

if [ -f "$TARGET_ABS/src/main/resources/static/index.html" ]; then
  printf 'STATIC_INDEX_HTML: yes\n'
else
  printf 'STATIC_INDEX_HTML: no\n'
fi

if [ -d "$TARGET_ABS/src/test" ]; then
  printf 'TEST_FOLDER: yes\n'
else
  printf 'TEST_FOLDER: no\n'
fi
